<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8" />
  <title>Product Rejected</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f6f8;
    font-family: Arial, sans-serif;
  "
>
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td align="center" style="padding: 40px 20px">
        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
            background: #ffffff;
            border-radius: 12px;
            overflow: hidden;
          "
        >
          <!-- HEADER -->
          <tr>
            <td
              align="center"
              style="
                background:#8751e4;
                color:#ffffff;
                padding:32px;
                border-bottom:5px solid #6d3fd4;
              "
            >

              <h1
                style="
                  margin:0;
                  font-size:28px;
                  font-weight:700;
                  letter-spacing:1px;
                "
              >
                PRODUCT REJECTED
              </h1>

            </td>
          </tr>

          <!-- CONTENT -->
          <tr>
            <td style="padding: 40px 30px">
              <h2
              style="
                margin-top:0;
                color:#111827;
                font-size:24px;
              "
            >
              Hello <%= sellerName %>,
            </h2>

              <p style="line-height:1.8;">
                We reviewed your product
                <strong><%= productName %></strong>, but unfortunately it could not be approved at this time.
              </p>

              <p style="line-height:1.8;">
                Please review the product details, make the necessary corrections, and submit it again for approval.
              </p>

              <div
                style="
                  background:#fef2f2;
                  border:1px solid #fecaca;
                  padding:16px;
                  border-radius:8px;
                  margin:24px 0;
                  color:#991b1b;
                "
              >

              <strong>Before Resubmitting</strong>

              <ul>
                <li>Product information is accurate</li>
                <li>Images are clear</li>
                <li>Pricing and quantity are valid</li>
              </ul>

              </div>

              <div style="margin: 30px 0">
                <a
                  href="https://rubberscrapmart.com"
                  style="
                    background: #dc2626;
                    color: white;
                    padding: 14px 24px;
                    text-decoration: none;
                    border-radius: 8px;
                    display: inline-block;
                  "
                >
                  Update Product
                </a>
              </div>

              <p>
                Thank you for using Rubber Scrap Mart.
              </p>
            </td>
          </tr>

          <!-- FOOTER -->
          <tr>
            <td
              align="center"
              style="
                padding: 20px;
                background: #f3f4f6;
                color: #6b7280;
                font-size: 14px;
              "
            >
              © 2026 Rubber Scrap Mart. All rights reserved.
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>